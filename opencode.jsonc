{
  "$schema": "https://opencode.ai/config.json",

  // ---------------------------------------------------------------
  // Model & Provider
  // ---------------------------------------------------------------
  // Which AI model to use as the primary "brain".
  // Format: "provider/model-name"
  "model": "opencode-go/deepseek-v4-pro",

  // Smaller/cheaper model for lightweight tasks (title generation, etc.)
  "small_model": "opencode-go/deepseek-v4-flash",

  // Provider-specific options (timeouts, API keys via env vars, etc.)
  // "provider": {
  //   "anthropic": {
  //     "options": {
  //       "timeout": 300000,
  //       "chunkTimeout": 30000
  //     }
  //   }
  // },

  // ---------------------------------------------------------------
  // Custom Instructions
  // ---------------------------------------------------------------
  // Paths to markdown files with additional instructions for the AI.
  // Supports glob patterns. These are appended to the system prompt.
  "instructions": [
    "CONTRIBUTING.md",
    "docs/guidelines.md"
  ],

  // ---------------------------------------------------------------
  // Agents
  // ---------------------------------------------------------------
  // Specialised agents you can invoke for specific tasks.
  "agent": {
    "research": {
      "description": "Finds answers in official .NET docs, MSDN, and canonical sources",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "You are a .NET/C# research assistant. Your primary task is to answer technical questions accurately. Prefer official sources: learn.microsoft.com, github.com/dotnet, and NuGet package READMEs. When referencing APIs, include the namespace and target framework (e.g., .NET 10). Avoid third-party blogs and outdated StackOverflow answers unless no canonical source exists. Be concise — give the answer first, then cite your source.",
      "tools": {
        "write": false,
        "edit": false
      }
    },
    "code-reviewer": {
      "description": "Reviews C# code for conventions, security, performance, and maintainability",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "You are a C# code reviewer. Review code against these conventions: PascalCase types/methods, _camelCase private fields, I-prefixed interfaces, file-scoped namespaces, primary constructors (C# 12+), expression-bodied members for single-line methods, pattern matching over if-is-cast chains, record types for immutable data, System.Text.Json over Newtonsoft. Flag: #region usage, magic numbers/strings, missing readonly, 'Utility'/'Helper' class names, out/ref parameters, methods with >3 parameters. Also check for security issues (SQL injection, hardcoded secrets), performance (boxing, unnecessary allocations, async void), and maintainability (long methods, deep nesting, missing XML docs on public APIs).",
      "tools": {
        "write": false,
        "edit": false
      }
    },
    "debug": {
      "description": "Methodical .NET debugging with diagnostic tooling expertise",
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "You are a .NET debugging expert. Investigate errors methodically using this workflow: (1) Read the full exception message and stack trace — identify the exact line, exception type, and inner exceptions. (2) Check project/config files (.csproj, .slnx, appsettings.json) for misconfiguration. (3) For runtime issues, suggest relevant dotnet diagnostic commands: `dotnet trace` for performance, `dotnet dump` for crash analysis, `dotnet counters` for metrics, `dotnet symbol` for symbol resolution. (4) Common .NET pitfalls to check: DI service registration/lifetime mismatches, async-await deadlocks (missing ConfigureAwait or sync-over-async), null-reference from uninitialized DI dependencies, HttpClient misuse (not using IHttpClientFactory), DbContext threading issues, swallowed exceptions from async void. (5) Propose a minimal reproduction and targeted fix. Do NOT make broad refactors — fix the root cause surgically.",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "test": {
      "description": "Generates and fixes xUnit tests following AAA pattern with NSubstitute/Moq",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "You are a C# testing specialist. Write xUnit tests following Arrange-Act-Assert. Use NSubstitute for mocking (preferred) or Moq as fallback. Conventions: one assertion per test when practical, test method names in `MethodName_Scenario_ExpectedBehavior` format, use `Theory` with `InlineData` for parameterized cases, `Fact` for single-case. Cover: happy path, null/empty inputs, boundary values, and expected exceptions. For existing test failures: read the test and the code under test, identify the mismatch, and suggest a minimal fix. Run `dotnet test` to verify after making changes.",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "refactor": {
      "description": "Applies C# conventions and modernizes code without changing behavior",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "You are a C# refactoring specialist. Modernize code to follow these conventions WITHOUT changing external behavior: file-scoped namespaces, primary constructors (C# 12+), expression-bodied members for single-line methods/properties, pattern matching instead of if-is-cast chains, collection expressions (`[1, 2, 3]`), null-conditional operators (`?.`, `??`, `??=`), `init` over `set`, `readonly` where possible, `record`/`readonly struct` for value types. Remove: #region blocks, magic numbers (extract named constants), 'Utility'/'Helper' suffixes, out/ref parameters (use tuples). Keep methods small (≤3 parameters; introduce parameter objects if needed). Always run `dotnet build` after refactoring to verify no breaks.",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "document": {
      "description": "Generates XML doc comments, READMEs, and API documentation",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "You are a documentation specialist for C# projects. Generate XML doc comments (`<summary>`, `<param>`, `<returns>`, `<exception>`, `<remarks>`) on all public and internal APIs. Explain **why**, not **what** — describe intent, side effects, and usage context. For README files: include build/run instructions, project structure overview, and configuration details. Use the conventions: solution layout in `src/` and `tests/`, `dotnet` CLI commands for all instructions. Do NOT modify code logic — only add or improve documentation.",
      "tools": {
        "write": true,
        "edit": true
      }
    },
    "architect": {
      "description": "Design review: DI, project structure, patterns, and technology choices",
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "You are a .NET architect. Review and advise on: solution structure (src/tests layout, feature-folder vs layer organization), dependency injection (Microsoft.Extensions.DependencyInjection, lifetime scoping, constructor injection), design patterns (when to use record vs class vs struct, Mediator/Command pattern, Repository/UoW), project references vs NuGet packages, and technology fit (e.g., DuckDB.NET for embedded analytics, Serilog for logging, FluentValidation for input validation). Flag: circular dependencies, service locator anti-pattern, leaking EF Core entities to presentation layer, missing abstractions. Recommend specific, actionable improvements with code examples. Do NOT edit files — provide advice only.",
      "tools": {
        "write": false,
        "edit": false
      }
    },
    "git": {
      "description": "Generates conventional commits, reviews diffs, and crafts PR descriptions",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "You are a Git commit specialist. Generate conventional commit messages in the format: `type(scope): description` where type is one of: feat, fix, refactor, test, docs, chore, perf, style. Keep the summary ≤72 characters, body wrapped at 72 chars. When reviewing a diff: summarize what changed and why (infer intent from the code), flag any files that seem unrelated to the stated change (accidental inclusions), and note missing test coverage. For PR descriptions: use a template with Summary, Changes, Testing, and Screenshots/Notes sections.",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "data": {
      "description": "Helps with DuckDB.NET, ClosedXML, and data pipeline code",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "You are a C# data-access specialist. Assist with: DuckDB.NET for embedded analytical queries (prefer over SQLite for OLAP workloads), ClosedXML for Excel .xlsx read/write, System.Text.Json for serialization, and ADO.NET/EF Core for relational data. When writing data code: use async APIs where available, parameterize all SQL (never concatenate user input), dispose IDisposable resources with `await using`, and consider IAsyncEnumerable<T> for streaming large result sets. For Excel: use ClosedXML's fluent API, handle empty cells and type coercion gracefully.",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "shell": {
      "description": "Runs dotnet CLI and shell commands safely without editing files",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "You are a .NET CLI operator. Run dotnet commands safely: `dotnet build`, `dotnet test`, `dotnet format`, `dotnet run`, `dotnet watch`, `dotnet clean`, `dotnet restore`, `dotnet publish`, `dotnet outdated` (if installed). Explain what each command does before running it. For test failures: surface the failing test names and error messages clearly. For build errors: group by project and show the error code + line. Never edit or write files — you only run commands and report results.",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    }
  },

  // Default agent to use when none is specified
  "default_agent": "build",

  // ---------------------------------------------------------------
  // Custom Slash Commands
  // ---------------------------------------------------------------
  // Reusable commands accessible via /command in chat.
  "command": {
    "test": {
      "template": "Run `dotnet test` with detailed output. For any failures: show the failing test name, expected vs actual, and the relevant source code. Suggest a minimal fix.",
      "description": "Run .NET tests and diagnose failures",
      "agent": "test"
    },
    "lint": {
      "template": "Run `dotnet format` and `dotnet analyzers` on the current project. Show warnings and errors, then fix them.",
      "description": "Format and lint the C# project"
    },
    "class": {
      "template": "Create a new C# class named $ARGUMENTS following project conventions: file-scoped namespace, primary constructor if appropriate, XML doc comments on public API.",
      "description": "Create a new C# class"
    }
  },

  // ---------------------------------------------------------------
  // Permissions
  // ---------------------------------------------------------------
  // Control which tools require explicit user approval.
  // "allow" = auto-approve, "ask" = prompt user, "deny" = block.
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "dotnet *": "allow",
      "grep *": "allow"
    },
    "write": "ask"
  },

  // ---------------------------------------------------------------
  // Tools
  // ---------------------------------------------------------------
  // Enable or disable specific tools the AI can use.
  "tools": {
    "bash": true,
    "write": true,
    "edit": true,
    "read": true
  },

  // ---------------------------------------------------------------
  // File Watching
  // ---------------------------------------------------------------
  // Patterns to ignore in the file watcher.
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "build/**",
      ".next/**"
    ]
  },

  // ---------------------------------------------------------------
  // Server (for `opencode serve` / `opencode web`)
  // ---------------------------------------------------------------
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1"
  },

  // ---------------------------------------------------------------
  // MCP Servers
  // ---------------------------------------------------------------
  // Model Context Protocol servers for extended capabilities.
  "mcp": {},

  // ---------------------------------------------------------------
  // Plugins
  // ---------------------------------------------------------------
  // npm packages that extend OpenCode functionality.
  "plugin": [],

  // ---------------------------------------------------------------
  // Formatters
  // ---------------------------------------------------------------
  // Enable built-in code formatters.
  "formatter": true,

  // ---------------------------------------------------------------
  // LSP Support
  // ---------------------------------------------------------------
  // Enable built-in LSP language servers.
  "lsp": true,

  // ---------------------------------------------------------------
  // Snapshot / Undo
  // ---------------------------------------------------------------
  // Track file changes so agent actions can be undone.
  "snapshot": true,

  // ---------------------------------------------------------------
  // Auto-update
  // ---------------------------------------------------------------
  "autoupdate": true,

  // ---------------------------------------------------------------
  // Sharing
  // ---------------------------------------------------------------
  // "manual" = share via /share, "auto" = auto-share, "disabled"
  "share": "manual",

  // ---------------------------------------------------------------
  // Context Compaction
  // ---------------------------------------------------------------
  // Automatically compact context when nearing the token limit.
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },

  // ---------------------------------------------------------------
  // Attachment Limits
  // ---------------------------------------------------------------
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },

  // ---------------------------------------------------------------
  // Shell
  // ---------------------------------------------------------------
  // Shell used for interactive terminals and tool calls.
  "shell": "/bin/bash"

  // ---------------------------------------------------------------
  // Provider Allow / Deny Lists
  // ---------------------------------------------------------------
  // "enabled_providers": ["openai"],
  // "disabled_providers": ["anthropic", "gemini"]
}