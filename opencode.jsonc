{
  "$schema": "https://opencode.ai/config.json",

  // ---------------------------------------------------------------
  // Model & Provider
  // ---------------------------------------------------------------
  // Which AI model to use as the primary "brain".
  // Format: "provider/model-name"
  "model": "opencode/deepseek-v4.1-flash",

  // Smaller/cheaper model for lightweight tasks (title generation, etc.)
  "small_model": "opencode/deepseek-v4.1-flash",

  // Provider-specific options (timeouts, API keys via env vars, etc.)
  // "provider": {
  //   "anthropic": {
  //     "options": {
  //       "timeout": 300000,
  //       "chunkTimeout": 30000
  //     }
  //   }
  // },

  // ---------------------------------------------------------------
  // Custom Instructions
  // ---------------------------------------------------------------
  // Paths to markdown files with additional instructions for the AI.
  // Supports glob patterns. These are appended to the system prompt.
  "instructions": [
    "CONTRIBUTING.md",
    "docs/guidelines.md",
    "skills/cli-output-contract/SKILL.md"
  ],

  // ---------------------------------------------------------------
  // Agents
  // ---------------------------------------------------------------
  "agent": {
    "coordinator": {
      "description": "Primary orchestrator. Smart planning and dispatching for engineering work.",
      "mode": "primary",
      "model": "opencode/deepseek-v4.1-flash",
      "steps": 30,
      "prompt": "{file:prompts/coordinator.md}"
    },
    "advisor": {
      "description": "Strategic advisor for second opinions, plan critique, and architecture tradeoffs.",
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/big-pickle",
      "steps": 15,
      "temperature": 0.3,
      "prompt": "{file:prompts/advisor.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "task": "deny",
        "question": "allow",
        "todowrite": "deny"
      }
    },
    "researcher": {
      "description": "Finds answers in official docs, package registries, and canonical sources",
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash",
      "prompt": "{file:prompts/researcher.md}",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },
    "code-reviewer": {
      "description": "Reviews code for conventions, security, performance, and maintainability (any language)",
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash",
      "prompt": "{file:prompts/code-reviewer.md}",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },
    "architect": {
      "description": "Design review: structure, patterns, technology choices (any language)",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "prompt": "{file:prompts/architect.md}",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },
    "debugger": {
      "description": "Methodical debugging with diagnostic tooling expertise (any language)",
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash",
      "prompt": "{file:prompts/debugger.md}",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },
    "test": {
      "description": "Generates and fixes tests following language conventions (any language)",
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash",
      "prompt": "{file:prompts/test.md}"
    },
    "refactor": {
      "description": "Modernizes code without changing behavior (any language)",
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash",
      "prompt": "{file:prompts/refactor.md}"
    },
    "documenter": {
      "description": "Generates API documentation, READMEs, and inline comments (any language)",
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash",
      "prompt": "{file:prompts/documenter.md}"
    },
    "shell": {
      "description": "Runs CLI commands safely without editing files (any language ecosystem)",
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash",
      "prompt": "{file:prompts/shell.md}",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },
    "git": {
      "description": "Generates conventional commits, reviews diffs, and crafts PR descriptions",
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash",
      "prompt": "You are a Git commit specialist. Generate conventional commit messages in the format: `type(scope): description` where type is one of: feat, fix, refactor, test, docs, chore, perf, style. Keep the summary ≤72 characters, body wrapped at 72 chars. When reviewing a diff: summarize what changed and why (infer intent from the code), flag any files that seem unrelated to the stated change (accidental inclusions), and note missing test coverage. For PR descriptions: use a template with Summary, Changes, Testing, and Screenshots/Notes sections.",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    }
  },

  // Default agent to use when none is specified
  "default_agent": "coordinator",

  // ---------------------------------------------------------------
  // Custom Slash Commands
  // ---------------------------------------------------------------
  // Reusable commands accessible via /command in chat.
  "command": {
    "test": {
      "template": "Run `dotnet test` with detailed output. For any failures: show the failing test name, expected vs actual, and the relevant source code. Suggest a minimal fix.",
      "description": "Run .NET tests and diagnose failures",
      "agent": "test"
    },
    "lint": {
      "template": "Run `dotnet format` and `dotnet analyzers` on the current project. Show warnings and errors, then fix them.",
      "description": "Format and lint the C# project"
    },
    "class": {
      "template": "Create a new C# class named $ARGUMENTS following project conventions: file-scoped namespace, primary constructor if appropriate, XML doc comments on public API.",
      "description": "Create a new C# class"
    }
  },

  // ---------------------------------------------------------------
  // Permissions
  // ---------------------------------------------------------------
  // Control which tools require explicit user approval.
  // "allow" = auto-approve, "ask" = prompt user, "deny" = block.
  //
  // Rules use last-matching-wins semantics, so "*": "ask" is first
  // and specific allow rules follow — the specific rules win.
  "permission": {
    // Tool-level permissions (non-bash tools)
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "webfetch": "allow",
    "edit": "allow",
    "write": "allow",

    // Bash command-level permissions
    // "*": "ask" acts as a safety net for anything explicitly destructive.
    // Every non-destructive command commonly used by agents gets auto-allowed.
    "bash": {
      // Catch-all: anything not matched below will prompt
      "*": "ask",

      // === Build & test commands ===
      "dotnet *": "allow",
      "cargo *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "bun *": "allow",
      "make *": "allow",
      "just *": "allow",

      // === File reading & searching ===
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "jq *": "allow",
      "strings *": "allow",
      "diff *": "allow",
      "comm *": "allow",
      "cut *": "allow",
      "paste *": "allow",
      "tr *": "allow",
      "od *": "allow",
      "xxd *": "allow",
      "hexdump *": "allow",

      // === Process & system info (read-only) ===
      "which *": "allow",
      "type *": "allow",
      "command *": "allow",
      "hash *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "printenv": "allow",
      "env": "allow",
      "date": "allow",
      "whoami": "allow",
      "id": "allow",
      "hostname": "allow",
      "uname *": "allow",
      "ps *": "allow",
      "lsof *": "allow",

      // === Network (read-only) ===
      "curl *": "allow",
      "wget *": "allow",
      "ping *": "allow",
      "nslookup *": "allow",
      "dig *": "allow",
      "ss *": "allow",
      "netstat *": "allow",

      // === Directory operations ===
      "mkdir *": "allow",
      "rmdir *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "tree *": "allow",

      // === Git ===
      "git *": "allow",

      // === Shell scripting ===
      "nu *": "allow",
      "bash *": "allow",
      "sh *": "allow",
      "zsh *": "allow",
      "source *": "allow",
      ".": "allow",
      "exec *": "allow",

      // === OpenCode itself ===
      "opencode *": "allow"
    }
  },

  // ---------------------------------------------------------------
  // Tools
  // ---------------------------------------------------------------
  // Enable or disable specific tools the AI can use.
  "tools": {
    "bash": true,
    "write": true,
    "edit": true,
    "read": true
  },

  // ---------------------------------------------------------------
  // File Watching
  // ---------------------------------------------------------------
  // Patterns to ignore in the file watcher.
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "build/**",
      ".next/**"
    ]
  },

  // ---------------------------------------------------------------
  // Server (for `opencode serve` / `opencode web`)
  // ---------------------------------------------------------------
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1"
  },

  // ---------------------------------------------------------------
  // MCP Servers
  // ---------------------------------------------------------------
  // Model Context Protocol servers for extended capabilities.
  "mcp": {},

  // ---------------------------------------------------------------
  // Plugins
  // ---------------------------------------------------------------
  // npm packages that extend OpenCode functionality.
  "plugin": [],

  // ---------------------------------------------------------------
  // Formatters
  // ---------------------------------------------------------------
  // Enable built-in code formatters.
  "formatter": true,

  // ---------------------------------------------------------------
  // LSP Support
  // ---------------------------------------------------------------
  // Enable built-in LSP language servers.
  "lsp": true,

  // ---------------------------------------------------------------
  // Snapshot / Undo
  // ---------------------------------------------------------------
  // Track file changes so agent actions can be undone.
  "snapshot": true,

  // ---------------------------------------------------------------
  // Auto-update
  // ---------------------------------------------------------------
  "autoupdate": true,

  // ---------------------------------------------------------------
  // Sharing
  // ---------------------------------------------------------------
  // "manual" = share via /share, "auto" = auto-share, "disabled"
  "share": "manual",

  // ---------------------------------------------------------------
  // Context Compaction
  // ---------------------------------------------------------------
  // Automatically compact context when nearing the token limit.
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },

  // ---------------------------------------------------------------
  // Attachment Limits
  // ---------------------------------------------------------------
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },

  // ---------------------------------------------------------------
  // Shell
  // ---------------------------------------------------------------
  // Shell used for interactive terminals and tool calls.
  "shell": "/bin/bash"

  // ---------------------------------------------------------------
  // Provider Allow / Deny Lists
  // ---------------------------------------------------------------
  // "enabled_providers": ["openai"],
  // "disabled_providers": ["anthropic", "gemini"]
}