{
  "$schema": "https://opencode.ai/config.json",
  // ---------------------------------------------------------------
  // Model & Provider
  // ---------------------------------------------------------------
  // Which AI model to use as the primary "brain".
  // Format: "provider/model-name"
  "model": "opencode/gemini-3.1-pro",
  // Smaller/cheaper model for lightweight tasks (title generation, etc.)
  "small_model": "opencode/deepseek-v4.1-flash",
  // ---------------------------------------------------------------
  // Custom Instructions
  // ---------------------------------------------------------------
  // Paths to markdown files with additional instructions for the AI.
  // Supports glob patterns. These are appended to the system prompt.
  "instructions": [
    "CONTRIBUTING.md",
    "docs/guidelines.md",
    "skills/cli-output-contract/SKILL.md"
  ],
  // ---------------------------------------------------------------
  // Agents
  // ---------------------------------------------------------------
  "agent": {
    "agent": {
      "plan": {
        "model": "opencode/gemini-3.1-pro"
      },
      "build": {
        "model": "opencode/deepseek-v4-flash"
      }
    }
  },
  // Default agent to use when none is specified
  "default_agent": "coordinator",
  // ---------------------------------------------------------------
  // Custom Slash Commands
  // ---------------------------------------------------------------
  // Reusable commands accessible via /command in chat.
  "command": {
    "test": {
      "template": "Run `dotnet test` with detailed output. For any failures: show the failing test name, expected vs actual, and the relevant source code. Suggest a minimal fix.",
      "description": "Run .NET tests and diagnose failures",
      "agent": "test"
    },
    "lint": {
      "template": "Run `dotnet format` and `dotnet analyzers` on the current project. Show warnings and errors, then fix them.",
      "description": "Format and lint the C# project"
    },
    "class": {
      "template": "Create a new C# class named $ARGUMENTS following project conventions: file-scoped namespace, primary constructor if appropriate, XML doc comments on public API.",
      "description": "Create a new C# class"
    }
  },
  // ---------------------------------------------------------------
  // Permissions
  // ---------------------------------------------------------------
  // Control which tools require explicit user approval.
  // "allow" = auto-approve, "ask" = prompt user, "deny" = block.
  //
  // Rules use last-matching-wins semantics, so "*": "ask" is first
  // and specific allow rules follow — the specific rules win.
  "permission": {
    // Tool-level permissions (non-bash tools)
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "webfetch": "allow",
    "edit": "allow",
    "write": "allow",
    // Bash command-level permissions
    // "*": "ask" acts as a safety net for anything explicitly destructive.
    // Every non-destructive command commonly used by agents gets auto-allowed.
    "bash": {
      // Catch-all: anything not matched below will prompt
      "*": "ask",
      // === Build & test commands ===
      "dotnet *": "allow",
      "cargo *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "bun *": "allow",
      "make *": "allow",
      "just *": "allow",
      // === File reading & searching ===
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "jq *": "allow",
      "strings *": "allow",
      "diff *": "allow",
      "comm *": "allow",
      "cut *": "allow",
      "paste *": "allow",
      "tr *": "allow",
      "od *": "allow",
      "xxd *": "allow",
      "hexdump *": "allow",
      // === Process & system info (read-only) ===
      "which *": "allow",
      "type *": "allow",
      "command *": "allow",
      "hash *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "printenv": "allow",
      "env": "allow",
      "date": "allow",
      "whoami": "allow",
      "id": "allow",
      "hostname": "allow",
      "uname *": "allow",
      "ps *": "allow",
      "lsof *": "allow",
      // === Network (read-only) ===
      "curl *": "allow",
      "wget *": "allow",
      "ping *": "allow",
      "nslookup *": "allow",
      "dig *": "allow",
      "ss *": "allow",
      "netstat *": "allow",
      // === Directory operations ===
      "mkdir *": "allow",
      "rmdir *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "tree *": "allow",
      // === File manipulations ===
      "cp *": "allow",
      "mv *": "allow",
      "rm *": "allow",
      "touch *": "allow",
      // === Additional languages & tools ===
      "python *": "allow",
      "python3 *": "allow",
      "pip *": "allow",
      "pytest *": "allow",
      "go *": "allow",
      "tsc *": "allow",
      "node *": "allow",
      // === Archives & Text processing ===
      "tar *": "allow",
      "zip *": "allow",
      "unzip *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      // === Git ===
      "git *": "allow",
      // === Shell scripting ===
      "nu *": "allow",
      "bash *": "allow",
      "sh *": "allow",
      "zsh *": "allow",
      "source *": "allow",
      ".": "allow",
      "exec *": "allow",
      // === OpenCode itself ===
      "opencode *": "allow"
    }
  },
  // ---------------------------------------------------------------
  // Tools
  // ---------------------------------------------------------------
  // Enable or disable specific tools the AI can use.
  "tools": {
    "bash": true,
    "write": true,
    "edit": true,
    "read": true
  },
  // ---------------------------------------------------------------
  // File Watching
  // ---------------------------------------------------------------
  // Patterns to ignore in the file watcher.
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "build/**",
      ".next/**"
    ]
  },
  // ---------------------------------------------------------------
  // Server (for `opencode serve` / `opencode web`)
  // ---------------------------------------------------------------
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1"
  },
  // ---------------------------------------------------------------
  // MCP Servers
  // ---------------------------------------------------------------
  // Model Context Protocol servers for extended capabilities.
  "mcp": {},
  // ---------------------------------------------------------------
  // Plugins
  // ---------------------------------------------------------------
  // npm packages that extend OpenCode functionality.
  "plugin": [],
  // ---------------------------------------------------------------
  // Formatters
  // ---------------------------------------------------------------
  // Enable built-in code formatters.
  "formatter": true,
  // ---------------------------------------------------------------
  // LSP Support
  // ---------------------------------------------------------------
  // Enable built-in LSP language servers.
  "lsp": true,
  // ---------------------------------------------------------------
  // Snapshot / Undo
  // ---------------------------------------------------------------
  // Track file changes so agent actions can be undone.
  "snapshot": true,
  // ---------------------------------------------------------------
  // Auto-update
  // ---------------------------------------------------------------
  "autoupdate": true,
  // ---------------------------------------------------------------
  // Sharing
  // ---------------------------------------------------------------
  // "manual" = share via /share, "auto" = auto-share, "disabled"
  "share": "manual",
  // ---------------------------------------------------------------
  // Context Compaction
  // ---------------------------------------------------------------
  // Automatically compact context when nearing the token limit.
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  // ---------------------------------------------------------------
  // Attachment Limits
  // ---------------------------------------------------------------
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  // ---------------------------------------------------------------
  // Shell
  // ---------------------------------------------------------------
  // Shell used for interactive terminals and tool calls.
  "shell": "/bin/bash"
  // ---------------------------------------------------------------
  // Provider Allow / Deny Lists
  // ---------------------------------------------------------------
  // "enabled_providers": ["openai"],
  // "disabled_providers": ["anthropic", "gemini"]
}